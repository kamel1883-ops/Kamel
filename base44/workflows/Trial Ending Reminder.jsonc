  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trial_ending_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "trialEndingReminder",
            "args": {
              "cron_secret": "${ env.CRON_SECRET }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0628\u0644\u0627\u063a \u0642\u0631\u0628 \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062a\u062c\u0631\u0628\u0629",
            "description": "\u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0641\u064a \u0622\u062e\u0631 7 \u0623\u064a\u0627\u0645 \u0645\u0646 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0623\u0648 \u0628\u0639\u062f \u0627\u0646\u062a\u0647\u0627\u0626\u0647\u0627"
          }
        }
      }
    ]
  },
  "description": "\u064a\u0631\u0633\u0644 \u062a\u0630\u0643\u064a\u0631\u0627\u064b \u0639\u0631\u0628\u064a\u0627\u064b \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0641\u064a \u0622\u062e\u0631 7 \u0623\u064a\u0627\u0645 \u0645\u0646 \u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0623\u0648 \u0628\u0639\u062f \u0627\u0646\u062a\u0647\u0627\u0626\u0647\u0627 \u0644\u0645\u0646 \u0644\u0645 \u064a\u062d\u0648\u0651\u0644 \u0644\u0627\u0634\u062a\u0631\u0627\u0643 (\u062a\u0634\u063a\u064a\u0644 \u064a\u0648\u0645\u064a)",
  "name": "Trial Ending Reminder"
}