{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_renewal_offer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_offers": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRenewalOffers",
            "args": {
              "cron_secret": "${ env.CRON_SECRET }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0648\u0644\u064a\u062f \u0639\u0631\u0648\u0636 \u0627\u0644\u062a\u062c\u062f\u064a\u062f \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629",
            "description": "\u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0642\u0631\u0628 \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u2014 \u064a\u064f\u0645\u0631\u0651\u0631 \u0633\u0631\u0651 CRON_SECRET \u062d\u0631\u0641\u064a\u064b\u0627"
          }
        }
      }
    ]
  },
  "description": "\u064a\u0648\u0644\u0651\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0639\u0631\u0648\u0636 \u062a\u062c\u062f\u064a\u062f \u0633\u0646\u0648\u064a\u0629 \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0627\u0634\u062a\u0631\u0627\u0643\u0627\u062a\u0647\u0645 \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u0627\u064b. \u064a\u062c\u0628 \u062a\u0645\u0631\u064a\u0631 CRON_SECRET \u0643\u0642\u064a\u0645\u0629 \u062d\u0631\u0641\u064a\u0629 \u0641\u064a args.cron_secret.",
  "name": "Auto Renewal Offer"
}