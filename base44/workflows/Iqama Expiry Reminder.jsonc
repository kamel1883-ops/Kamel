{
  "name": "Iqama Expiry Reminder",
  "description": "\u0641\u062d\u0635 \u0623\u0633\u0628\u0648\u0639\u064a \u0644\u062a\u0648\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0625\u0642\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u2014 \u064a\u064f\u0646\u0634\u0626 \u0625\u0634\u0639\u0627\u0631\u0627\u064b \u062f\u0627\u062e\u0644\u064a\u0627\u064b \u0648\u064a\u0631\u0633\u0644 \u0628\u0631\u064a\u062f\u0627\u064b \u0644\u0644\u0645\u0627\u0644\u0643 \u0639\u0646 \u0627\u0644\u0625\u0642\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0623\u0648 \u0627\u0644\u0645\u0648\u0634\u0643\u0629 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u0627\u064b. \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 (iqama_expiry) \u0648\u0644\u0627 \u064a\u0633\u062a\u0639\u0644\u0645 \u0645\u0646 \u0623\u0628\u0634\u0631.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 0",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "iqama_expiry_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "iqamaExpiryReminder",
            "args": {
              "cron_secret": "${ env.CRON_SECRET }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0646\u0628\u064a\u0647 \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0625\u0642\u0627\u0645\u0627\u062a",
            "description": "\u0641\u062d\u0635 \u0623\u0633\u0628\u0648\u0639\u064a \u2014 \u064a\u064f\u0645\u0631\u0651\u0631 CRON_SECRET \u062d\u0631\u0641\u064a\u064b\u0627"
          }
        }
      }
    ]
  }
}