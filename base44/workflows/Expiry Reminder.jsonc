{
  "name": "Expiry Reminder",
  "description": "\u0641\u062d\u0635 \u0623\u0633\u0628\u0648\u0639\u064a \u0634\u0627\u0645\u0644 \u0644\u0643\u0644 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621\u0627\u062a: \u062a\u0631\u0627\u062e\u064a\u0635 \u0627\u0644\u0645\u0646\u0634\u0623\u0629\u060c \u0627\u0634\u062a\u0631\u0627\u0643\u0627\u062a \u062d\u0643\u0648\u0645\u064a\u0629\u060c \u0625\u0642\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646\u060c \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629\u060c \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0637\u0628\u064a\u060c \u0631\u062e\u0635/\u062a\u0623\u0645\u064a\u0646/\u0641\u062d\u0635 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a\u060c \u0648\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 (90 \u064a\u0648\u0645\u0627\u064b). \u064a\u064f\u0646\u0634\u0626 \u0625\u0634\u0639\u0627\u0631\u0627\u064b \u062f\u0627\u062e\u0644\u064a\u0627\u064b + \u0628\u0631\u064a\u062f\u0627\u064b \u0644\u0644\u0645\u0627\u0644\u0643 \u0628\u0643\u0644 \u0645\u0627 \u064a\u0646\u062a\u0647\u064a \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u0627\u064b \u0623\u0648 \u0645\u0646\u062a\u0647\u064d. \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 0",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expiry_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expiryReminder",
            "args": {
              "cron_secret": "${ env.CRON_SECRET }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621\u0627\u062a \u0627\u0644\u0634\u0627\u0645\u0644",
            "description": "\u0641\u062d\u0635 \u0623\u0633\u0628\u0648\u0639\u064a \u2014 \u0643\u0644 \u0627\u0644\u062a\u0631\u0627\u062e\u064a\u0635 \u0648\u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643\u0627\u062a \u0648\u0627\u0644\u0625\u0642\u0627\u0645\u0627\u062a \u0648\u0627\u0644\u0639\u0642\u0648\u062f \u0648\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0648\u0627\u0644\u062a\u062c\u0631\u0628\u0629"
          }
        }
      }
    ]
  }
}