  "properties": {
    "role": {
      "type": "string",
      "description": "\u062f\u0648\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645: admin (\u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629/\u0627\u0644\u0645\u0627\u0644\u0643)\u060c manager (\u0645\u062f\u064a\u0631 \u0645\u0628\u0627\u0634\u0631 \u2014 \u0645\u0648\u0627\u0641\u0642\u0627\u062a \u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a \u0641\u0642\u0637)\u060c finance (\u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0627\u0644\u064a \u2014 \u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0644\u0644\u0625\u062c\u0627\u0632\u0627\u062a \u0648\u0627\u0644\u0633\u0644\u0641 \u0648\u0627\u0644\u0627\u0646\u062a\u062f\u0627\u0628\u0627\u062a)\u060c user (\u0645\u0648\u0638\u0641)",
      "enum": [
        "admin",
        "manager",
        "finance",
        "user"
      ]
    }
  },
