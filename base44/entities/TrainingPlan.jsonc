{
  "name": "TrainingPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u062e\u0637\u0629"
    },
    "scope": {
      "type": "string",
      "enum": [
        "employee",
        "department"
      ],
      "default": "employee",
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 (\u0623\u0648\u0644 \u0645\u0648\u0638\u0641 \u2014 \u0644\u0644\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629)"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641 (\u0644\u0644\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629)"
    },
    "employee_ids": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u064a\u0646 (\u0645\u0635\u0641\u0648\u0641\u0629 JSON)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629: [\"id1\",\"id2\"]"
    },
    "employee_names": {
      "type": "string",
      "title": "\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u064a\u0646 (\u0642\u0627\u0626\u0645\u0629 \u0644\u0644\u0639\u0631\u0636)"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629 / \u0627\u0644\u0642\u0633\u0645"
    },
    "deficiency": {
      "type": "string",
      "title": "\u0645\u0634\u0627\u0643\u0644 \u0627\u0644\u0646\u0642\u0635 \u0644\u062f\u0649 \u0627\u0644\u0645\u0648\u0638\u0641",
      "maxLength": 3000
    },
    "goal": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u062f\u0641 \u0628\u0639\u062f \u0627\u0644\u062e\u0637\u0629",
      "maxLength": 2000
    },
    "mechanism": {
      "type": "string",
      "title": "\u0622\u0644\u064a\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
      "maxLength": 2000
    },
    "cost": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u062a\u0643\u0644\u0641\u0629 (\u0631\u064a\u0627\u0644)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0647\u0627\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641 \u0648\u0627\u0644\u0634\u0631\u062d",
      "maxLength": 5000
    }
  },
  "required": [
    "title",
    "scope",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.employee_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}