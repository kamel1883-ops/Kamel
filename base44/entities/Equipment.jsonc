{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "laptop",
        "phone",
        "sim",
        "tablet",
        "clothing",
        "work_phone",
        "camera",
        "tool",
        "other"
      ],
      "default": "other",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0647\u062f\u0629"
    },
    "custom_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0645\u062e\u0635\u0635 (\u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u00ab\u0623\u062e\u0631\u0649\u00bb)"
    },
    "item_label": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0639\u0647\u062f\u0629 / \u0627\u0644\u0628\u064a\u0627\u0646"
    },
    "serial_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u0644\u0633\u0644\u064a / \u0631\u0642\u0645 \u0627\u0644\u0623\u0635\u0644"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0631\u062c\u0627\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "returned",
        "lost",
        "damaged"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "condition_note": {
      "type": "string",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0647\u062f\u0629 \u0639\u0646\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645/\u0627\u0644\u0625\u0631\u062c\u0627\u0639"
    },
    "return_note": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0625\u0631\u062c\u0627\u0639 (\u0643\u0633\u0631/\u062a\u0644\u0641/\u0646\u0642\u0635...)",
      "maxLength": 3000
    },
    "return_deduction": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0635\u0645 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0638\u0641 \u0639\u0646\u062f \u0627\u0644\u0625\u0631\u062c\u0627\u0639 (\u0631.\u0633)"
    },
    "return_received_by": {
      "type": "string",
      "title": "\u0627\u0633\u062a\u0644\u0645 \u0627\u0644\u0625\u0631\u062c\u0627\u0639 \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629)"
    },
    "request_id": {
      "type": "string",
      "title": "\u0637\u0644\u0628 \u0627\u0644\u0639\u0647\u062f\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0639\u0647\u062f\u0629 (\u0631.\u0633)"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645)"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "employee_id",
    "item_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}