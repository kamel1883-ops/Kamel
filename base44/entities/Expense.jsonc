{
  "name": "Expense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0635\u0631\u0648\u0641"
    },
    "category": {
      "type": "string",
      "enum": [
        "platform",
        "server",
        "domain",
        "email",
        "marketing",
        "commission",
        "partner_share",
        "salary",
        "tools",
        "other"
      ],
      "default": "other",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0635\u0631\u0648\u0641"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a (\u0631\u064a\u0627\u0644)"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "yearly",
        "per_revenue"
      ],
      "default": "one_time",
      "title": "\u0627\u0644\u062a\u0643\u0631\u0627\u0631 (\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 / \u0634\u0647\u0631\u064a / \u0633\u0646\u0648\u064a / \u0645\u0639 \u0643\u0644 \u0625\u064a\u0631\u0627\u062f)"
    },
    "expense_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0635\u0631\u0648\u0641 (\u0623\u0648 \u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u0643\u0631\u0627\u0631)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0642\u0641 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a \u2014 \u0644\u0644\u0645\u0635\u0631\u0648\u0641 \u0627\u0644\u0645\u062a\u0643\u0631\u0631)"
    },
    "vendor": {
      "type": "string",
      "title": "\u0627\u0644\u062c\u0647\u0629 / \u0627\u0644\u0645\u0632\u0648\u0651\u062f"
    },
    "partner_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u0641\u064a\u062f (\u0646\u0633\u0628\u0629 / \u0639\u0645\u0648\u0644\u0629)"
    },
    "commission_percent": {
      "type": "number",
      "default": 0,
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 %"
    },
    "base_amount": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u0628\u064a\u0639 \u0627\u0644\u0630\u064a \u062d\u064f\u0633\u0628\u062a \u0639\u0644\u064a\u0647 \u0627\u0644\u0639\u0645\u0648\u0644\u0629"
    },
    "revenue_ref": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0645\u064a\u0644 / \u0627\u0644\u0625\u064a\u0631\u0627\u062f \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stopped"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a",
      "maxLength": 1000
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}