{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "annual",
        "sick",
        "emergency",
        "unpaid",
        "maternity",
        "permission"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0625\u062c\u0627\u0632\u0629"
    },
    "annual_leave_mode": {
      "type": "string",
      "enum": [
        "actual_travel",
        "encash_continue"
      ],
      "default": "actual_travel",
      "title": "\u0648\u0636\u0639 \u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0647\u0627\u064a\u0629"
    },
    "days_count": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "permission_minutes": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u0626\u0630\u0627\u0646 \u0628\u0627\u0644\u062f\u0642\u0627\u0626\u0642"
    },
    "reason": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u0628\u0628"
    },
    "medical_report_url": {
      "type": "string",
      "title": "\u062a\u0642\u0631\u064a\u0631 \u0637\u0628\u064a \u0645\u0631\u0641\u0642"
    },
    "is_full_clearance": {
      "type": "boolean",
      "default": false,
      "title": "\u0625\u062c\u0627\u0632\u0629 \u0643\u0627\u0645\u0644\u0629 \u0628\u062a\u0635\u0641\u064a\u0629 \u0648\u062a\u0630\u0627\u0643\u0631"
    },
    "manager_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "manager_note": {
      "type": "string"
    },
    "manager_date": {
      "type": "string",
      "format": "date"
    },
    "hr_status": {
      "type": "string",
      "enum": [
        "pending",
        "settled",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_id": {
      "type": "string"
    },
    "hr_name": {
      "type": "string"
    },
    "hr_note": {
      "type": "string"
    },
    "hr_document_url": {
      "type": "string"
    },
    "hr_date": {
      "type": "string",
      "format": "date"
    },
    "balance_deducted": {
      "type": "number",
      "default": 0,
      "title": "\u0623\u064a\u0627\u0645 \u0645\u062e\u0635\u0648\u0645\u0629 \u0645\u0646 \u0627\u0644\u0631\u0635\u064a\u062f"
    },
    "balance_before": {
      "type": "number",
      "default": 0
    },
    "balance_after": {
      "type": "number",
      "default": 0
    },
    "settlement_pdf_url": {
      "type": "string"
    },
    "ticket_amount": {
      "type": "number",
      "default": 0
    },
    "deduction_amount": {
      "type": "number",
      "default": 0
    },
    "deduction_note": {
      "type": "string"
    },
    "addition_amount": {
      "type": "number",
      "default": 0
    },
    "addition_note": {
      "type": "string"
    },
    "settlement_amount": {
      "type": "number",
      "default": 0
    },
    "finance_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "finance_note": {
      "type": "string"
    },
    "finance_paid_date": {
      "type": "string",
      "format": "date"
    },
    "finance_proof_url": {
      "type": "string"
    },
    "finance_proof_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_manager",
        "manager_approved",
        "hr_settled",
        "hr_approved",
        "awaiting_finance",
        "paid",
        "completed",
        "rejected",
        "pending",
        "approved"
      ],
      "default": "pending_manager",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u064f\u0641\u0648\u0651\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "employee_id",
    "leave_type",
    "start_date",
    "end_date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}