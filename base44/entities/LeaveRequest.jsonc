{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "annual",
        "sick",
        "emergency",
        "unpaid",
        "maternity"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0625\u062c\u0627\u0632\u0629"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0647\u0627\u064a\u0629"
    },
    "days_count": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "reason": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u0628\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "reviewed_by": {
      "type": "string",
      "title": "\u0645\u0631\u0627\u062c\u0650\u0639"
    },
    "review_note": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0644\u0645\u0631\u0627\u062c\u0639"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    }
  },
  "required": [
    "employee_id",
    "leave_type",
    "start_date",
    "end_date",
    "status"
  ]
}