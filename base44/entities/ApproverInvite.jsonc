{
  "name": "ApproverInvite",
  "type": "object",
  "properties": {
    "invite_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062a\u062f \u0627\u0644\u0645\u0639\u062a\u0651\u0645\u062f \u0627\u0644\u0645\u0645\u062f\u0639\u0648\u0651"
    },
    "role": {
      "type": "string",
      "enum": [
        "manager",
        "finance"
      ],
      "default": "manager",
      "title": "\u0627\u0644\u062f\u0648\u0631"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "used",
        "revoked"
      ],
      "default": "pending",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "token": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0627\u0644\u062f\u0639\u0648\u0629 (\u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u0633\u062c\u064a\u0644)"
    },
    "used_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    }
  },
  "required": [
    "invite_email",
    "role",
    "status",
    "token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}