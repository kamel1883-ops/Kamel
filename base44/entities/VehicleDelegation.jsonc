{
  "name": "VehicleDelegation",
  "type": "object",
  "properties": {
    "delegation_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0648\u0643\u064a\u0644"
    },
    "vehicle_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0631\u0643\u0628\u0629"
    },
    "plate_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0644\u0648\u062d\u0629"
    },
    "vehicle_label": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0631\u0643\u0628\u0629"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u064f\u0648\u0643\u0651\u0644"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "national_id": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629"
    },
    "position": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "delegation_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0643\u064a\u0644 \u0627\u0644\u0641\u0639\u0644\u064a"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u062a\u0648\u0643\u064a\u0644"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "title": "\u062a\u0648\u0643\u064a\u0644 \u0633\u0627\u0631\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "returned"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "created_by_name": {
      "type": "string",
      "title": "\u0623\u0635\u062f\u0631\u0647 / \u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645)"
    },
    "created_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "vehicle_id",
    "employee_id",
    "delegation_date",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}