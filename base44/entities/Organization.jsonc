{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "commercial_register": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "vat_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "city": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "title": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "logo_url": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0639\u0627\u0631"
    },
    "annual_leave_days": {
      "type": "number",
      "default": 21,
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629"
    },
    "ticket_policy": {
      "type": "string",
      "enum": [
        "yearly",
        "biennial",
        "none"
      ],
      "default": "yearly",
      "title": "\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062a\u0630\u0627\u0643\u0631"
    },
    "ticket_value": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0629"
    },
    "eos_basis": {
      "type": "string",
      "enum": [
        "base_only",
        "gross"
      ],
      "default": "gross",
      "title": "\u0623\u0633\u0627\u0633 \u062d\u0633\u0627\u0628 \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "gosi_saudi_employee_rate": {
      "type": "number",
      "default": 9.75,
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 - \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0633\u0639\u0648\u062f\u064a %"
    },
    "gosi_saudi_employer_rate": {
      "type": "number",
      "default": 9.75,
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 - \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0645\u0644 \u0644\u0644\u0633\u0639\u0648\u062f\u064a %"
    },
    "gosi_expat_employer_rate": {
      "type": "number",
      "default": 2,
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 - \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0645\u0644 \u0644\u0644\u0645\u0642\u064a\u0645 %"
    },
    "work_week_hours": {
      "type": "number",
      "default": 48,
      "title": "\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a\u0629"
    },
    "work_week_days": {
      "type": "number",
      "default": 6,
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a\u0629"
    },
    "late_grace_minutes": {
      "type": "number",
      "default": 15,
      "title": "\u0633\u0645\u0627\u062d \u0627\u0644\u062a\u0623\u062e\u064a\u0631 (\u062f\u0642\u064a\u0642\u0629)"
    },
    "absence_deduction_type": {
      "type": "string",
      "enum": [
        "daily_wage",
        "monthly_divided"
      ],
      "default": "monthly_divided",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u062e\u0635\u0645 \u0627\u0644\u063a\u064a\u0627\u0628"
    },
    "workplace_lat": {
      "type": "number",
      "title": "\u062e\u0637 \u0639\u0631\u0636 \u0645\u0642\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "workplace_lng": {
      "type": "number",
      "title": "\u062e\u0637 \u0637\u0648\u0644 \u0645\u0642\u0631 \u0627\u0644\u0639\u0645\u0644"
    },
    "workplace_radius": {
      "type": "number",
      "default": 50,
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0628\u0635\u0645\u0629 (\u0645\u062a\u0631)"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}