{
  "name": "BusinessTrip",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ],
      "default": "internal",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0631\u062d\u0644\u0629"
    },
    "destination": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u062c\u0647\u0629"
    },
    "purpose": {
      "type": "string",
      "title": "\u0627\u0644\u063a\u0631\u0636 \u0645\u0646 \u0627\u0644\u0631\u062d\u0644\u0629"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0647\u0627\u064a\u0629"
    },
    "days_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645"
    },
    "transport_mode": {
      "type": "string",
      "enum": [
        "plane",
        "car",
        "bus",
        "train",
        "none"
      ],
      "default": "car",
      "title": "\u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u062a\u0646\u0642\u0644"
    },
    "transport_cost": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062a\u0646\u0642\u0644"
    },
    "accommodation_cost": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0625\u0642\u0627\u0645\u0629"
    },
    "per_diem": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644 \u0627\u0644\u0627\u0646\u062a\u062f\u0627\u0628 \u0627\u0644\u064a\u0648\u0645\u064a"
    },
    "per_diem_total": {
      "type": "number",
      "default": 0,
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0628\u062f\u0644 \u0627\u0644\u0627\u0646\u062a\u062f\u0627\u0628"
    },
    "other_costs": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0643\u0627\u0644\u064a\u0641 \u0623\u062e\u0631\u0649"
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "title": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0643\u0644\u0641\u0629"
    },
    "advance_amount": {
      "type": "number",
      "default": 0,
      "title": "\u0633\u0644\u0641\u0629 \u0639\u0644\u0649 \u0627\u0644\u062d\u0633\u0627\u0628"
    },
    "employee_note": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0648\u0638\u0641 \u0644\u0644\u0627\u0646\u062a\u062f\u0627\u0628"
    },
    "employee_document_url": {
      "type": "string",
      "title": "\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "manager_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "manager_note": {
      "type": "string"
    },
    "manager_date": {
      "type": "string",
      "format": "date"
    },
    "hr_note": {
      "type": "string"
    },
    "hr_document_url": {
      "type": "string"
    },
    "approval_pdf_url": {
      "type": "string"
    },
    "finance_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "finance_note": {
      "type": "string"
    },
    "finance_paid_date": {
      "type": "string",
      "format": "date"
    },
    "finance_proof_url": {
      "type": "string"
    },
    "finance_proof_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_manager",
        "pending",
        "manager_approved",
        "awaiting_finance",
        "approved",
        "in_progress",
        "completed",
        "cancelled",
        "rejected"
      ],
      "default": "pending_manager",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "approver_id": {
      "type": "string"
    },
    "approver_name": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645) \u2014 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u064f\u0641\u0648\u0651\u0636"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "employee_id",
    "trip_type",
    "start_date",
    "end_date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}