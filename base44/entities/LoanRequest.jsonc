{
  "name": "LoanRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "amount": {
      "type": "number",
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "reason": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u0628\u0628"
    },
    "installment_count": {
      "type": "number",
      "default": 1,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0633\u0627\u0637 \u0627\u0644\u0634\u0647\u0631\u064a\u0629"
    },
    "monthly_installment": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u0633\u0637 \u0627\u0644\u0634\u0647\u0631"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0645 \u0633\u062f\u0627\u062f"
    },
    "statement_pdf_url": {
      "type": "string",
      "title": "\u0643\u0634\u0641 \u0627\u0644\u0633\u0644\u0641\u0629 (PDF)"
    },
    "manager_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "manager_note": {
      "type": "string"
    },
    "manager_date": {
      "type": "string",
      "format": "date"
    },
    "hr_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_id": {
      "type": "string"
    },
    "hr_name": {
      "type": "string"
    },
    "hr_note": {
      "type": "string"
    },
    "hr_date": {
      "type": "string",
      "format": "date"
    },
    "finance_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "rejected"
      ],
      "default": "pending",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u0645\u0627\u0644\u064a"
    },
    "finance_paid_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0635\u0631\u0641"
    },
    "finance_proof_url": {
      "type": "string",
      "title": "\u0625\u062b\u0628\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644"
    },
    "finance_proof_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_manager",
        "manager_approved",
        "hr_approved",
        "awaiting_finance",
        "paid",
        "completed",
        "rejected"
      ],
      "default": "pending_manager",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641",
      "maxLength": 1000
    }
  },
  "required": [
    "employee_id",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}