{
  "name": "License",
  "type": "object",
  "properties": {
    "license_type": {
      "type": "string",
      "enum": [
        "cr",
        "municipality",
        "civil_defense",
        "industrial",
        "modon",
        "sfda",
        "medical",
        "veterinary",
        "safety_maintenance",
        "labor",
        "gosi",
        "transport",
        "tourism",
        "other"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0631\u062e\u064a\u0635"
    },
    "custom_label": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0645\u062e\u0635\u0635"
    },
    "license_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0631\u062e\u064a\u0635"
    },
    "issuing_authority": {
      "type": "string",
      "title": "\u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0627\u0646\u062d\u0629"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621"
    },
    "duration_months": {
      "type": "number",
      "title": "\u0645\u062f\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 (\u0623\u0634\u0647\u0631)"
    },
    "not_applicable": {
      "type": "boolean",
      "default": false,
      "title": "\u0644\u0627 \u064a\u0646\u0637\u0628\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "document_url": {
      "type": "string",
      "title": "\u0646\u0633\u062e\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635 (\u0631\u0627\u0628\u0637)"
    }
  },
  "required": [
    "license_type"
  ]
}