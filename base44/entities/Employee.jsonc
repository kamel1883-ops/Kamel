{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "national_id": {
      "type": "string",
      "title": "\u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 / \u0631\u0642\u0645 \u0627\u0644\u0625\u0642\u0627\u0645\u0629"
    },
    "nationality": {
      "type": "string",
      "title": "\u0627\u0644\u062c\u0646\u0633\u064a\u0629"
    },
    "is_saudi": {
      "type": "boolean",
      "default": false,
      "title": "\u0633\u0639\u0648\u062f\u064a"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "title": "\u0627\u0644\u062c\u0646\u0633"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "address": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "emergency_contact": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0637\u0648\u0627\u0631\u0626"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "position": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "job_grade": {
      "type": "string",
      "title": "\u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0639\u064a\u064a\u0646"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0642\u062f"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_leave",
        "terminated",
        "resigned"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629"
    },
    "termination_reason": {
      "type": "string",
      "enum": [
        "none",
        "end_of_contract",
        "employer_termination",
        "resignation",
        "dismissal_for_cause",
        "force_majeure"
      ],
      "default": "none",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0625\u0646\u0647\u0627\u0621"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0646\u0647\u0627\u0621"
    },
    "manager_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "base_salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a"
    },
    "housing_allowance": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644 \u0627\u0644\u0633\u0643\u0646"
    },
    "transport_allowance": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644 \u0627\u0644\u0645\u0648\u0627\u0635\u0644\u0627\u062a"
    },
    "other_allowances": {
      "type": "number",
      "default": 0,
      "title": "\u0628\u062f\u0644\u0627\u062a \u0623\u062e\u0631\u0649"
    },
    "avatar_url": {
      "type": "string",
      "title": "\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629"
    },
    "iqama_expiry": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0625\u0642\u0627\u0645\u0629"
    },
    "passport_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0632"
    },
    "passport_expiry": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062c\u0648\u0627\u0632"
    },
    "health_insurance_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0637\u0628\u064a"
    },
    "health_insurance_expiry": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0637\u0628\u064a"
    },
    "bank_account": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0628\u0646\u0643\u064a"
    },
    "leave_balance": {
      "type": "number",
      "default": 0,
      "title": "\u0631\u0635\u064a\u062f \u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0629 (\u0623\u064a\u0627\u0645)"
    },
    "ticket_entitlement": {
      "type": "string",
      "enum": [
        "yearly",
        "biennial",
        "none"
      ],
      "default": "yearly",
      "title": "\u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0627\u0644\u062a\u0630\u0627\u0643\u0631"
    },
    "ticket_last_used_year": {
      "type": "number",
      "title": "\u0622\u062e\u0631 \u0633\u0646\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0630\u0643\u0631\u0629"
    }
  },
  "required": [
    "employee_number",
    "department",
    "position",
    "hire_date",
    "base_salary"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}