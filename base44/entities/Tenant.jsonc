{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "commercial_register": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "vat_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "logo_url": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0639\u0627\u0631"
    },
    "industry": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0637\u0627\u0639 / \u0627\u0644\u0646\u0634\u0627\u0637"
    },
    "contact_name": {
      "type": "string",
      "title": "\u062c\u0647\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"
    },
    "contact_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u062c\u0647\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"
    },
    "contact_phone": {
      "type": "string",
      "title": "\u0647\u0627\u062a\u0641 \u062c\u0647\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f (\u064a\u0628\u062f\u0623 \u0628\u06407)"
    },
    "city": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "country": {
      "type": "string",
      "default": "\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629",
      "title": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "annual",
        "monthly",
        "none"
      ],
      "default": "trial",
      "title": "\u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "trial",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "trial_start": {
      "type": "string",
      "format": "date",
      "title": "\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629"
    },
    "trial_end": {
      "type": "string",
      "format": "date",
      "title": "\u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629"
    },
    "subscription_end": {
      "type": "string",
      "format": "date",
      "title": "\u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "discount_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "discount_percent": {
      "type": "number",
      "default": 0,
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u0645\u0637\u0628\u0642\u0629 %"
    },
    "quoted_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0639\u0631\u0648\u0636 (\u0633\u0639\u0631 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 \u0628\u0639\u062f \u0627\u0644\u062e\u0635\u0645)"
    },
    "employee_count": {
      "type": "number",
      "default": 0,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0642\u0639"
    },
    "pricing_tier": {
      "type": "string",
      "title": "\u0634\u0631\u064a\u062d\u0629 \u0627\u0644\u0623\u0633\u0639\u0627\u0631"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}