{
  "name": "Complaint",
  "type": "object",
  "properties": {
    "complaint_ref": {
      "type": "string",
      "title": "\u0631\u0645\u0632 \u0627\u0644\u062e\u0632\u0646\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u2014 \u0645\u0631\u062c\u0639 \u0645\u0639\u062a\u0645 \u0644\u0644\u0633\u062c\u0644 \u0627\u0644\u0643\u0627\u0645\u0644 (\u0627\u0644\u0648\u0635\u0641 \u0627\u0644\u062d\u0633\u0627\u0633)"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "complaint_type": {
      "type": "string",
      "enum": [
        "ethical",
        "pressure",
        "sexual_harassment",
        "discrimination",
        "safety",
        "work_environment",
        "other"
      ],
      "default": "work_environment",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0634\u0643\u0648\u0649"
    },
    "custom_type": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0646\u0648\u0639 \u0627\u0644\u0634\u0643\u0648\u0649 (\u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u00ab\u0623\u062e\u0631\u0649\u00bb)"
    },
    "description": {
      "type": "string",
      "title": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0634\u0643\u0648\u0649",
      "maxLength": 3000
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0634\u0643\u0648\u0649"
    },
    "is_confidential": {
      "type": "boolean",
      "default": false,
      "title": "\u0633\u0631\u064a\u0629 \u2014 \u062a\u064f\u0639\u0627\u0644\u062c \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0641\u0642\u0637"
    },
    "manager_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0645\u0648\u0641\u0642\u0629/\u0625\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "manager_note": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631"
    },
    "manager_date": {
      "type": "string",
      "format": "date"
    },
    "hr_status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0644\u062f\u0649 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629"
    },
    "hr_id": {
      "type": "string"
    },
    "hr_name": {
      "type": "string"
    },
    "hr_resolution": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0644 \u0627\u0644\u0645\u064f\u0642\u062f\u0651\u0645 \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629",
      "maxLength": 3000
    },
    "hr_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_manager",
        "manager_approved",
        "resolved",
        "rejected"
      ],
      "default": "pending_manager",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "prepared_by_name": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645)"
    },
    "prepared_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    }
  },
  "required": [
    "employee_id",
    "complaint_type",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.employee_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}