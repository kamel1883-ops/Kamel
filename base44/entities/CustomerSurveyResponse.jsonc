{
  "name": "CustomerSurveyResponse",
  "type": "object",
  "properties": {
    "survey_id": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u062a\u0628\u064a\u0627\u0646"
    },
    "survey_title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0627\u0633\u062a\u0628\u064a\u0627\u0646"
    },
    "tenant_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "tenant_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "unified_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0645\u0648\u062d\u062f"
    },
    "contact_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    },
    "answers": {
      "type": "string",
      "title": "\u0627\u0644\u0623\u062c\u0648\u0628\u0629 (JSON)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629: [{\"questionIndex\":0,\"rating\":5}]"
    },
    "avg_rating": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "default": "neutral",
      "title": "\u0627\u0644\u0627\u0646\u0637\u0628\u0627\u0639 \u0627\u0644\u0639\u0627\u0645"
    },
    "comment": {
      "type": "string",
      "maxLength": 1000,
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    }
  },
  "required": [
    "survey_id",
    "submitted_date",
    "answers"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}