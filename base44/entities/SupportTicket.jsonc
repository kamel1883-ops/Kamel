      "title": "\u0631\u0642\u0645 \u0627\u0644\u062a\u0630\u0643\u0631\u0629 (JDR-001)"
    },
    "category": {
      "type": "string",
      "title": "\u0641\u0626\u0629 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 (\u0645\u0641\u062a\u0627\u062d)"
    },
    "category_label": {
      "type": "string",
      "title": "\u0641\u0626\u0629 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 (\u0639\u0631\u0628\u064a)"
    },
    "subcategory": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 (\u0645\u0641\u062a\u0627\u062d)"
    },
    "subcategory_label": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 (\u0639\u0631\u0628\u064a)"
    },
    "subject": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0645\u062e\u062a\u0635\u0631",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0625\u0634\u0643\u0627\u0644\u064a\u0629",
      "maxLength": 5000
    },
    "attachment_urls": {
      "type": "string",
      "title": "\u0645\u0631\u0641\u0642\u0627\u062a (JSON \u2014 \u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u0635\u0648\u0631)"
    },
    "client_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0645\u064f\u0642\u062f\u0651\u0645 \u0627\u0644\u062a\u0630\u0643\u0631\u0629"
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "title": "\u0628\u0631\u064a\u062f \u0645\u064f\u0642\u062f\u0651\u0645 \u0627\u0644\u062a\u0630\u0643\u0631\u0629"
    },
    "client_phone": {
      "type": "string",
      "title": "\u062c\u0648\u0627\u0644 \u0645\u064f\u0642\u062f\u0651\u0645 \u0627\u0644\u062a\u0630\u0643\u0631\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "pending_info",
        "resolved",
        "closed"
      ],
      "default": "open",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "low",
      "title": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629"
    },
    "owner_reply": {
      "type": "string",
      "title": "\u0622\u062e\u0631 \u0631\u062f \u0645\u0646 \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0641\u0646\u064a"
    },
    "reply_history": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0631\u062f\u0648\u062f (JSON)"
    },
    "internal_note": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0629 \u062f\u0627\u062e\u0644\u064a\u0629 (\u0644\u0644\u062f\u0639\u0645 \u0641\u0642\u0637)"
    },
    "resolved_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0644"
    },
    "closed_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u063a\u0644\u0627\u0642"
    }
  },
  "required": [
    "ticket_number",
    "category",
    "client_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
