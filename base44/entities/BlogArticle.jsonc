    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "title": "\u0645\u0642\u0627\u0644 \u0645\u0645\u064a\u0651\u0632"
    },
    "reading_minutes": {
      "type": "number",
      "default": 3,
      "title": "\u0645\u062f\u0629 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 (\u062f\u0642\u0627\u0626\u0642)"
