    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0634\u0631"
    },
    "cover_image_url": {
      "type": "string",
