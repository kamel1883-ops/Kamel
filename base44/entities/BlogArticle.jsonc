        "payroll",
        "attendance",
        "eos",
        "hr_management",
        "saudization",
        "contracts",
        "general"
      ],
      "default": "general",
      "title": "\u0627\u0644\u062a\u0635\u0646\u064a\u0641"
    },
    "tags": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0633\u0648\u0645 (\u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0627\u0635\u0644\u0629)"
