    },
    "meta_description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 Meta",
      "maxLength": 300
    },
    "meta_keywords": {
      "type": "string",
      "title": "\u0643\u0644\u0645\u0627\u062a \u0645\u0641\u062a\u0627\u062d\u064a\u0629"
    },
    "lang": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "default": "ar",
      "title": "\u0627\u0644\u0644\u063a\u0629"
    }
  },
  "required": [
    "title",
    "slug",
    "content",
    "status"
  ],
  "rls": {
