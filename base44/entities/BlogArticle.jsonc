      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "slug": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0639\u0631\u0651\u0641 (slug)"
    },
    "excerpt": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0642\u062a\u0637\u0641",
      "maxLength": 500
    },
    "content": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062d\u062a\u0648\u0649 (Markdown)",
      "maxLength": 20000
    },
    "category": {
      "type": "string",
      "enum": [
