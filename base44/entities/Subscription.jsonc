{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "tenant_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "plan": {
      "type": "string",
      "enum": [
        "annual",
        "monthly"
      ],
      "default": "annual",
      "title": "\u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "title": "\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0641\u062a\u0631\u0629"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "title": "\u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0641\u062a\u0631\u0629"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "online",
        "direct"
      ],
      "default": "direct",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cancelled"
      ],
      "default": "paid",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "proof_url": {
      "type": "string",
      "title": "\u0625\u062b\u0628\u0627\u062a \u0627\u0644\u062f\u0641\u0639"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062f\u0641\u0639"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "tenant_id",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}