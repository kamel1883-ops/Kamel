{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "\u0627\u0644\u0643\u0648\u062f"
    },
    "discount_percent": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062e\u0635\u0645 %",
      "default": 0
    },
    "label": {
      "type": "string",
      "title": "\u0648\u0635\u0641 / \u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0643\u0648\u062f"
    },
    "max_uses": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 (0 = \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f)"
    },
    "used_count": {
      "type": "number",
      "default": 0,
      "title": "\u0645\u0631\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "code",
    "discount_percent",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}