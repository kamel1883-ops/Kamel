{
  "name": "Affiliate",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u064a\u0643"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "channel": {
      "type": "string",
      "title": "\u0642\u0646\u0627\u0629 \u0627\u0644\u062a\u0631\u0648\u064a\u062c"
    },
    "about": {
      "type": "string",
      "title": "\u0646\u0628\u0630\u0629 \u0639\u0646 \u0627\u0644\u0634\u0631\u064a\u0643 \u0648\u062c\u0645\u0647\u0648\u0631\u0647",
      "maxLength": 2000
    },
    "ref_code": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0645\u0631\u062c\u0639\u064a \u0644\u0644\u0634\u0631\u064a\u0643 (\u0641\u0631\u064a\u062f \u2014 \u064a\u064f\u0648\u0644\u0651\u062f \u0622\u0644\u064a\u0627\u064b)"
    },
    "commission_percent": {
      "type": "number",
      "default": 7,
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 % (7% \u0645\u0646 \u0623\u0648\u0644 \u0627\u0634\u062a\u0631\u0627\u0643 \u0641\u0642\u0637)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "default": "pending",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u2014 pending: \u0637\u0644\u0628 \u0627\u0646\u0636\u0645\u0627\u0645 \u062c\u062f\u064a\u062f\u060c active: \u0631\u0627\u0628\u0637 \u0627\u0644\u0625\u062d\u0627\u0644\u0629 \u064a\u0639\u0645\u0644\u060c suspended: \u0645\u0648\u0642\u0648\u0641"
    },
    "joined_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "bank_name": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0646\u0643"
    },
    "bank_iban": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0622\u064a\u0628\u0627\u0646 \u0644\u0635\u0631\u0641 \u0627\u0644\u0639\u0645\u0648\u0644\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a",
      "maxLength": 1000
    }
  },
  "required": [
    "full_name",
    "ref_code",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}