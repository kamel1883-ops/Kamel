{
  "name": "Incentive",
  "type": "object",
  "properties": {
    "incentive_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062d\u0627\u0641\u0632"
    },
    "incentive_type": {
      "type": "string",
      "enum": [
        "bonus",
        "cash_reward",
        "allowance_grant",
        "gift",
        "recognition",
        "other"
      ],
      "default": "bonus",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062d\u0627\u0641\u0632"
    },
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062d\u0627\u0641\u0632 (\u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629)"
    },
    "body": {
      "type": "string",
      "title": "\u0628\u064a\u0627\u0646 \u0627\u0644\u062d\u0627\u0641\u0632 (\u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629)",
      "maxLength": 6000
    },
    "i18n": {
      "type": "string",
      "title": "\u062a\u0631\u062c\u0645\u0627\u062a \u0627\u0644\u0639\u0646\u0648\u0627\u0646/\u0627\u0644\u0628\u064a\u0627\u0646 (JSON 7 \u0644\u063a\u0627\u062a)",
      "description": "\u0645\u0635\u0641\u0648\u0641\u0629 JSON: {\"title\":{...},\"body\":{...}}"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a (\u0631\u064a\u0627\u0644)"
    },
    "target": {
      "type": "string",
      "enum": [
        "all",
        "department",
        "employee"
      ],
      "default": "employee",
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0646\u062d"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0625\u062f\u0627\u0631\u0629 (\u0639\u0646\u062f \u0646\u0637\u0627\u0642 \u0642\u0633\u0645)"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 (\u0639\u0646\u062f \u0646\u0637\u0627\u0642 \u0641\u0631\u062f)"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_user_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "granted_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0646\u062d"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "granted",
        "revoked"
      ],
      "default": "draft",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "payroll_included": {
      "type": "boolean",
      "default": false,
      "title": "\u064a\u064f\u0636\u0645\u064e\u0651\u0646 \u0645\u0639 \u0627\u0644\u0631\u0627\u062a\u0628"
    },
    "created_by_name": {
      "type": "string",
      "title": "\u0623\u0635\u062f\u0631\u0647 / \u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0627\u0633\u0645)"
    },
    "created_by_id": {
      "type": "string",
      "title": "\u0623\u064f\u0639\u062f\u0651\u062a \u0628\u0648\u0627\u0633\u0637\u0629 (\u0627\u0644\u0647\u0648\u064a\u0629/\u0627\u0644\u0625\u0642\u0627\u0645\u0629)"
    },
    "acknowledged_log": {
      "type": "string",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}